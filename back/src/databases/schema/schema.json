        "vagas":{"type":"int"},
        "id_esporte":{"type":"int", "nullable":false,"foreignkey":true, "references": "esportes", "idreference":"id_esporte"},
        "id_instituicao":{"type":"int", "nullable":false, "foreignkey":true, "references": "instituicoes", "idreference":"id_instituicao"},
