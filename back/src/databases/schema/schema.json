{
  "tables": {
    "users": {
      "columns": {
        "id": { "type": "int", "primaryKey": true, "autoIncrement": true },
        "name": { "type": "string", "size": 100, "nullable": false , "unique": true},
        "login": { "type": "string", "size": 150, "nullable": false , "unique": true},
        "password": { "type": "string", "size": 254, "nullable": false },  
        "validated" : { "type": "boolean", "nullable": false, "default": false },            
        "created_at": {
          "type": "datetime",
          "nullable": false,
          "default": true
        },
        "actived": { "type": "boolean", "nullable": false, "default": true }
      }
    },
    "roles": {
      "columns": {
        "id": { "type": "int", "primaryKey": true, "autoIncrement": true },
        "role": { "type": "string", "size": 100, "nullable": false, "unique": true },
        "created_at": { "type": "datetime", "nullable": false, "default": true }
      }
    },
    "usersroles": {
      "columns": {
        "id": { "type": "int", "primaryKey": true, "autoIncrement": true },
        "idroler": { "type": "int", "nullable": false },
        "iduser": { "type": "int", "nullable": false , "unique": true},
        "created_at": { "type": "datetime", "nullable": false, "default": true }
      }
    },
    "esportes": {
      "columns": {
        "id_esporte": { "type": "int", "primaryKey": true, "autoIncrement": true },
        "nome_esporte": { "type": "string", "size": 150, "nullable": false },
        "created_at": { "type": "datetime", "nullable": false, "default": true }
      }
    },
    "atletas":{
      "columns":{
        "id_atleta":{"type":"int", "autoIncrement":true, "primaryKey":true},
        "nome": { "type": "string", "size": 100, "nullable": false },
        "email": { "type": "string", "size": 100, "nullable": false },
        "senha": { "type": "string", "size": 255, "nullable": false },
        "data_nascimento": { "type": "date",  "nullable": false },
        "telefone": { "type": "string", "size": 20, "nullable": false },
