# url ou dominio
@URL = http://localhost
# Porta do servidor
@PORT = 3600
# endpoint ou rota do teste
@ENDPOINT = atletas
# uri - rota final do teste
@URI = {{URL}}:{{PORT}}/{{ENDPOINT}}

